/*
 * AWS Batch execution profile
 *
 * Pairs with the Terraform stack in terraform/.
 *
 * Included from the profiles block in nextflow.config, which means conf/base.config
 * is read AFTER this file. That ordering is deliberate and this profile depends on
 * it: the params.max_* ceilings set below are what base.config's resourceLimits
 * clamps against, so raising them here is what lets the per-label
 * `memory = { N.GB * task.attempt }` escalation actually climb on retry instead of
 * hitting the laptop ceiling.
 *
 * For the same reason this file must NOT set process.cpus, process.memory,
 * process.time, any withLabel block, errorStrategy, maxRetries or maxErrors.
 * base.config sets all of those and would silently win.
 *
 * Account-specific values arrive as params rather than being hardcoded, so nothing
 * identifying this AWS account is ever committed. terraform/env.sh exports them.
 *
 * Usage:
 *   source terraform/env.sh
 *   nextflow run . -profile awsbatch \
 *     --aws_queue    "$NXF_BATCH_QUEUE" \
 *     --aws_job_role "$NXF_BATCH_JOB_ROLE" \
 *     --outdir       "$NXF_RESULTS"
 *
 * Run as `-profile awsbatch` alone. Do not combine with the docker profile:
 * its runOptions resolve the submitting user's uid, which is meaningless on a
 * Batch host, and Batch launches containers itself from process.container.
 */

params {
    // Ceilings for resourceLimits in base.config. Sized against the instance
    // families in terraform/variables.tf (m5, m5a, r5, r5a, c5) and kept below
    // the compute environment's max_vcpus so a single task cannot monopolise it.
    max_cpus              = 32
    max_memory            = '120.GB'
    max_time              = '48.h'

    // The submitting laptop's core count says nothing about a Batch instance.
    cap_resources_to_host = false

    // Supplied at runtime from terraform output via terraform/env.sh.
    aws_queue    = null
    aws_job_role = null

    // Host path where the launch template user data installs AWS CLI v2.
    // Nextflow bind-mounts the parent directory into every job container.
    aws_cli_path = '/opt/aws-cli/bin/aws'

    aws_region   = 'eu-west-1'
}

process {
    executor = 'awsbatch'
    queue    = params.aws_queue
}

executor {
    // Ceiling on jobs in flight. Batch's own scheduler handles the rest.
    queueSize = 50

    // Batch throttles SubmitJob. Without a rate limit a wide fan-out step
    // triggers TooManyRequestsException and Nextflow gives up on tasks that
    // would have succeeded a second later.
    submitRateLimit = '20/1min'
}

aws {
    region = params.aws_region

    batch {
        cliPath = params.aws_cli_path
        jobRole = params.aws_job_role

        // S3 staging is the slow part of a Batch run. These control how hard
        // Nextflow pushes and how forgiving it is of transient failures.
        maxParallelTransfers = 8
        maxTransferAttempts  = 3
        delayBetweenAttempts = '10 sec'
    }

    client {
        uploadChunkSize   = 20971520   // 20 MB
        maxConnections    = 20
        connectionTimeout = 60000
    }
}

/*
 * Not set here, on purpose:
 *
 *   workDir     Nextflow reads NXF_WORK from the environment. env.sh exports it.
 *   timeline/report/trace/dag
 *               Already configured in nextflow.config lines 85-88.
 *   docker.enabled
 *               The awsbatch executor does not use the local Docker daemon.
 */
