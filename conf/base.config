/*
 * Resource labels. Nothing here knows about a specific machine - the ceilings
 * come from params.max_* so the same code runs on a laptop and on Slurm.
 */

// Nextflow's local executor treats a task requesting more CPU or RAM than the
// machine has as a hard error rather than queueing it, so a config written on a
// 16 GB desktop fails outright on a 4 GB CI runner. Clamp to the host when
// running locally. On a cluster the login node's specs say nothing about the
// compute nodes, so profiles that submit elsewhere set cap_resources_to_host = false.
def check_max(obj, type) {
    if (type == 'memory') {
        try {
            def max = params.max_memory as nextflow.util.MemoryUnit
            if (params.cap_resources_to_host) {
                try {
                    def host = nextflow.util.SysHelper.getAvailMemory()
                    if (host && host.compareTo(max) == -1) { max = host }
                } catch (ignored) { /* host detection unavailable; ceiling stands */ }
            }
            return obj.compareTo(max) == 1 ? max : obj
        } catch (all) { return obj }
    } else if (type == 'time') {
        try {
            def max = params.max_time as nextflow.util.Duration
            return obj.compareTo(max) == 1 ? max : obj
        } catch (all) { return obj }
    } else if (type == 'cpus') {
        try {
            // Computed inside the method on purpose: in a Groovy script a
            // script-level 'def' variable is not visible from inside a 'def'
            // method, so hoisting this out silently throws and the catch below
            // hands back the unclamped request.
            def host_cpus = Runtime.runtime.availableProcessors()
            def n = Math.min(obj as int, params.max_cpus as int)
            if (params.cap_resources_to_host) { n = Math.min(n, host_cpus) }
            return Math.max(n, 1)
        }
        catch (all) { return obj }
    }
}

process {

    cpus   = { check_max( 1    * task.attempt, 'cpus'   ) }
    memory = { check_max( 4.GB * task.attempt, 'memory' ) }
    time   = { check_max( 2.h  * task.attempt, 'time'   ) }

    errorStrategy = { task.exitStatus in [104,134,137,139,140,143,247] ? 'retry' : 'finish' }
    maxRetries    = 2
    maxErrors     = '-1'

    withLabel: process_low {
        cpus   = { check_max( 2,               'cpus'   ) }
        memory = { check_max( 4.GB  * task.attempt, 'memory' ) }
        time   = { check_max( 2.h   * task.attempt, 'time'   ) }
    }
    withLabel: process_medium {
        cpus   = { check_max( 4,               'cpus'   ) }
        memory = { check_max( 8.GB  * task.attempt, 'memory' ) }
        time   = { check_max( 8.h   * task.attempt, 'time'   ) }
    }
    withLabel: process_high {
        cpus   = { check_max( 8,               'cpus'   ) }
        memory = { check_max( 12.GB * task.attempt, 'memory' ) }
        time   = { check_max( 24.h  * task.attempt, 'time'   ) }
    }
    withLabel: process_high_memory {
        // Kraken2 loads the whole database into RAM.
        cpus   = { check_max( 4,               'cpus'   ) }
        memory = { check_max( 10.GB * task.attempt, 'memory' ) }
        time   = { check_max( 4.h   * task.attempt, 'time'   ) }
    }
}
