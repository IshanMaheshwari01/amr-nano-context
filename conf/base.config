/*
 * Resource labels. Nothing here knows about a specific machine: the ceilings
 * come from params.max_* so the same code runs on a laptop and on Slurm.
 *
 * resourceLimits clamps every request to those ceilings. It replaces the older
 * check_max() helper, which cannot be used from Nextflow 26 onwards because the
 * config parser no longer allows method or variable declarations in a config file.
 *
 * The local executor treats a task asking for more CPU than the machine has as a
 * hard error rather than queueing it, so the CPU ceiling is also clamped to the
 * host core count. On a cluster the login node's core count says nothing about
 * the compute nodes, so profiles that submit elsewhere set cap_resources_to_host = false.
 */

process {

    resourceLimits = [
        cpus  : params.cap_resources_to_host
                    ? Math.min(params.max_cpus as int, Runtime.runtime.availableProcessors())
                    : params.max_cpus as int,
        memory: params.max_memory,
        time  : params.max_time
    ]

    cpus   = { 1     * task.attempt }
    memory = { 4.GB  * task.attempt }
    time   = { 2.h   * task.attempt }

    errorStrategy = { task.exitStatus in [104,134,137,139,140,143,247] ? 'retry' : 'finish' }
    maxRetries    = 2
    maxErrors     = '-1'

    withLabel: process_low {
        cpus   = { 2 }
        memory = { 4.GB  * task.attempt }
        time   = { 2.h   * task.attempt }
    }
    withLabel: process_medium {
        cpus   = { 4 }
        memory = { 8.GB  * task.attempt }
        time   = { 8.h   * task.attempt }
    }
    withLabel: process_high {
        cpus   = { 8 }
        memory = { 12.GB * task.attempt }
        time   = { 24.h  * task.attempt }
    }
    withLabel: process_high_memory {
        // Kraken2 loads the whole database into RAM.
        cpus   = { 4 }
        memory = { 10.GB * task.attempt }
        time   = { 4.h   * task.attempt }
    }
}
