/*
 * Fallback for machines without Docker. Slower to resolve and less reproducible
 * than the pinned containers, so it is not the default.
 */

process {
    withName: 'SEQKIT_STATS'       { conda = 'bioconda::seqkit=2.8.2' }
    withName: 'NANOQ'              { conda = 'bioconda::nanoq=0.10.0' }
    withName: 'NANOPLOT'           { conda = 'bioconda::nanoplot=1.42.0' }
    withName: 'KRAKEN2_READS'      { conda = 'bioconda::kraken2=2.1.3' }
    withName: 'KRAKEN2_CONTIGS'    { conda = 'bioconda::kraken2=2.1.3' }
    withName: 'BRACKEN'            { conda = 'bioconda::bracken=2.9' }
    withName: 'FLYE'               { conda = 'bioconda::flye=2.9.5' }
    withName: 'AMRFINDERPLUS'      { conda = 'bioconda::ncbi-amrfinderplus=4.0.19' }
    withName: 'ABRICATE'           { conda = 'bioconda::abricate=1.0.1' }
    withName: 'GENOMAD'            { conda = 'bioconda::genomad=1.8.0' }
    withName: 'MULTIQC'            { conda = 'bioconda::multiqc=1.25.1' }
    withName: 'ARG_CONTEXT'        { conda = 'conda-forge::pandas=2.2.1' }
    withName: 'VALIDATE_RESISTOME' { conda = 'conda-forge::pandas=2.2.1' }
}
