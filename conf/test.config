/*
 * Tiny profile used by CI. Runs with -stub-run so no real tool executes and no
 * database is needed; it proves the channel wiring and the DAG are valid.
 */

params {
    input           = "${projectDir}/assets/samplesheet_test.csv"
    outdir          = 'results_test'
    kraken2_db      = "${projectDir}/test-data/db_stub"
    genomad_db      = "${projectDir}/test-data/db_stub"
    amrfinder_db    = "${projectDir}/test-data/db_stub"
    max_cpus        = 1
    max_memory      = '1.GB'
    max_time        = '1.h'
}
