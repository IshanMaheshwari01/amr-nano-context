/*
 * Per-process publishing and command-line arguments. Keeping args out of the
 * module bodies means a threshold can be changed without touching the code
 * that runs the tool.
 */

// Every publishDir below reuses this so that overriding the output directory
// does not accidentally start publishing versions.yml alongside the results.
// Those are collected once into pipeline_info/software_versions.yml instead.
def drop_versions = { fn -> fn.equals('versions.yml') ? null : fn }

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].toLowerCase()}" },
        mode: 'copy',
        saveAs: drop_versions
    ]

    withName: 'NANOQ' {
        ext.args = { "--min-len ${params.min_read_len} --min-qual ${params.min_read_q}" }
    }

    withName: 'FLYE' {
        ext.args = { "${params.flye_extra}" }
        publishDir = [
            path: { "${params.outdir}/assembly" },
            mode: 'copy',
            saveAs: drop_versions
        ]
    }

    withName: 'ABRICATE' {
        ext.args = { "--minid ${params.min_arg_id} --mincov ${params.min_arg_cov}" }
    }

    withName: 'ARG_CONTEXT' {
        publishDir = [
            path: { "${params.outdir}/resistome" },
            mode: 'copy',
            saveAs: drop_versions
        ]
    }

    withName: 'VALIDATE_RESISTOME' {
        publishDir = [
            path: { "${params.outdir}/validation" },
            mode: 'copy',
            saveAs: drop_versions
        ]
    }

    withName: 'MULTIQC' {
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: 'copy',
            saveAs: drop_versions
        ]
    }
}
