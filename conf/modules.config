/*
 * Per-process publishing and command-line arguments. Keeping args out of the
 * module bodies means a threshold can be changed without touching the code
 * that runs the tool.
 */

// Note the repeated saveAs on every publishDir below. It suppresses versions.yml,
// which is collected once into pipeline_info/software_versions.yml instead. It
// cannot be factored into a shared variable because Nextflow 26's config parser
// disallows variable declarations in config files, so if you add a publishDir,
// copy the saveAs line with it.

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].toLowerCase()}" },
        mode: 'copy',
        saveAs: { fn -> fn.equals('versions.yml') ? null : fn }
    ]

    withName: 'NANOQ' {
        ext.args = { "--min-len ${params.min_read_len} --min-qual ${params.min_read_q}" }
    }

    withName: 'FLYE' {
        ext.args = { "${params.flye_extra}" }
        publishDir = [
            path: { "${params.outdir}/assembly" },
            mode: 'copy',
            saveAs: { fn -> fn.equals('versions.yml') ? null : fn }
        ]
    }

    withName: 'ABRICATE' {
        ext.args = { "--minid ${params.min_arg_id} --mincov ${params.min_arg_cov}" }
    }

    withName: 'ARG_CONTEXT' {
        publishDir = [
            path: { "${params.outdir}/resistome" },
            mode: 'copy',
            saveAs: { fn -> fn.equals('versions.yml') ? null : fn }
        ]
    }

    withName: 'VALIDATE_RESISTOME' {
        publishDir = [
            path: { "${params.outdir}/validation" },
            mode: 'copy',
            saveAs: { fn -> fn.equals('versions.yml') ? null : fn }
        ]
    }

    withName: 'MULTIQC' {
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: 'copy',
            saveAs: { fn -> fn.equals('versions.yml') ? null : fn }
        ]
    }
}
