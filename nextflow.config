/*
 * amr-nano-context : top-level configuration
 */

params {
    // input / output
    input            = null
    outdir           = 'results'
    help             = false

    // databases (no defaults on purpose - these are large and machine-specific)
    kraken2_db       = null
    genomad_db       = null

    // read filtering
    min_read_len     = 1000
    min_read_q       = 10

    // assembly
    flye_mode        = '--nano-hq'   // use --nano-raw for pre-2021 R9.4 data
    flye_extra       = '--meta'

    // ARG calling thresholds
    min_arg_id       = 90
    min_arg_cov      = 60

    // context calling
    plasmid_score    = 0.7
    max_plasmid_len  = 500000

    // behaviour
    skip_validation  = false

    // resource ceilings - lower these on a laptop
    max_cpus         = 8
    max_memory       = '14.GB'
    max_time         = '48.h'
    cap_resources_to_host = true   // set false in profiles that submit to a cluster
}

includeConfig 'conf/containers.config'
includeConfig 'conf/base.config'
includeConfig 'conf/modules.config'

profiles {
    docker {
        docker.enabled         = true
        docker.runOptions      = '-u $(id -u):$(id -g)'
        singularity.enabled    = false
        conda.enabled          = false
    }
    singularity {
        singularity.enabled    = true
        singularity.autoMounts = true
        docker.enabled         = false
    }
    conda {
        conda.enabled          = true
        docker.enabled         = false
        includeConfig 'conf/conda.config'
    }
    laptop {
        // 16 GB / 8 core desktop. Kraken2 standard-8 needs ~8 GB resident.
        params.max_cpus   = 6
        params.max_memory = '12.GB'
    }
    test {
        includeConfig 'conf/test.config'
    }
}

// ---- reporting --------------------------------------------------------------
def trace_ts = new java.util.Date().format('yyyy-MM-dd_HH-mm-ss')

timeline { enabled = true; file = "${params.outdir}/pipeline_info/timeline_${trace_ts}.html" }
report   { enabled = true; file = "${params.outdir}/pipeline_info/report_${trace_ts}.html" }
trace    { enabled = true; file = "${params.outdir}/pipeline_info/trace_${trace_ts}.txt" }
dag      { enabled = true; file = "${params.outdir}/pipeline_info/dag_${trace_ts}.html" }

manifest {
    name            = 'amr-nano-context'
    author          = 'Ishan Tushar Maheshwari'
    homePage        = 'https://github.com/IshanMaheshwari01/amr-nano-context'
    description     = 'Long-read metagenomic resistome profiling with plasmid and host context resolution'
    mainScript      = 'main.nf'
    nextflowVersion = '>=24.04.0'
    version         = '0.1.0'
}
